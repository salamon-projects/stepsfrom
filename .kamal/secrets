# Secrets for Kamal, read from the environment. GitHub Actions sets them from
# repository secrets (see .github/workflows/deploy.yml). Never put real
# values in this file.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
# The app connects as the POSTGRES_USER created by the PostGIS container.
STEPSFROM_DATABASE_PASSWORD=$POSTGRES_PASSWORD
ADMIN_USER=$ADMIN_USER
ADMIN_PASSWORD=$ADMIN_PASSWORD

%footer.site-footer
  .container
    %p.site-footer__disclosure= t("offers.disclosure")
    %nav.site-footer__links{ "aria-label": "Footer" }
      = link_to "How we verify & rank", how_we_verify_path
      = link_to "Affiliate disclosure", affiliate_disclosure_path
      = link_to "Privacy", privacy_path
    %p.site-footer__attribution
      Map data and waterfront measurements based on
      = succeed "," do
        = link_to "© OpenStreetMap contributors", "https://www.openstreetmap.org/copyright", rel: "noopener"
      available under the Open Database License.

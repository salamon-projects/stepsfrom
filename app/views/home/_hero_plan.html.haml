-# A plan-view sketch of what we measure: one stay on the beach, one across
-# the road. Decorative; the text beside it says the same.
%svg.hero-plan{ viewBox: "0 0 480 400", "aria-hidden": "true", focusable: "false" }
  %path.hero-plan__sea{ d: "M0 302C120 272 222 322 332 287S452 247 480 252V400H0Z" }
  - [ 28, 56, 84 ].each do |offset|
    %path.hero-plan__contour{ d: "M0 #{302 + offset}C120 #{272 + offset} 222 #{322 + offset} 332 #{287 + offset}S452 #{247 + offset} 480 #{252 + offset}" }
  %path.hero-plan__beach{ d: "M0 302C120 272 222 322 332 287S452 247 480 252V226C430 222 382 250 330 258S150 248 0 272Z" }
  %path.hero-plan__road{ d: "M0 150C150 176 320 128 480 160" }
  %path.hero-plan__road-line{ d: "M0 150C150 176 320 128 480 160" }
  %g.hero-plan__blocks
    %rect{ x: "36", y: "60", width: "52", height: "34" }
    %rect{ x: "112", y: "48", width: "38", height: "54" }
    %rect{ x: "196", y: "70", width: "60", height: "30" }
    %rect{ x: "420", y: "70", width: "40", height: "44" }
    %rect{ x: "60", y: "196", width: "44", height: "30" }
  %g.hero-plan__rejected
    %rect.hero-plan__building{ x: "330", y: "78", width: "58", height: "38" }
    %path.hero-plan__measure-line{ d: "M359 116V279" }
    %path{ d: "M352 145l14 14M366 145l-14 14" }
    %text{ x: "350", y: "188", "text-anchor": "end" } 64 m
    %text.hero-plan__note{ x: "350", y: "203", "text-anchor": "end" } across a road
  %g.hero-plan__verified
    %rect.hero-plan__building{ x: "210", y: "212", width: "52", height: "32" }
    %path.hero-plan__measure-line{ d: "M236 244V302M229 244h14M229 302h14" }
    %text{ x: "160", y: "282" } 18 m
    %text.hero-plan__note{ x: "112", y: "336" } Verified beachfront
  %g.hero-plan__scale
    %path{ d: "M20 382h60M20 377v10M50 379v6M80 377v10" }
    %text{ x: "88", y: "386" } 50 m

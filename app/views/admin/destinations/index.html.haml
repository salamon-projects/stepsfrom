- content_for :title, "Destinations"
- importing = @latest_imports.values.any?(&:active?)
- content_for(:auto_refresh, true) if importing

.admin-page__header
  %h1 Destinations
  = link_to "New destination", new_admin_destination_path, class: "button"

%p
  “Import from OSM” fetches coastline, lakes, beaches, roads and accommodation inside the bounding box from the
  Overpass API, then measures every property. New properties land in the review queue.
  = link_to "Import history", admin_imports_path
- if importing
  %p.flash An import is running. This page refreshes every 10 seconds.

.table-wrap
  %table.admin-table
    %thead
      %tr
        %th Destination
        %th Country
        %th Water
        %th Bounding box (S, W, N, E)
        %th Properties
        %th Listed
        %th Published
        %th Last import
        %th
          %span.visually-hidden Actions
    %tbody
      - @destinations.each do |destination|
        %tr
          %td= link_to destination.name, admin_properties_path(view: "all", destination_id: destination.id)
          %td= destination.country_name
          %td= destination.sea_name
          %td= destination.bbox.map { |v| v.round(4) }.join(", ")
          %td= @property_counts.fetch(destination.id, 0)
          %td= @listed_counts.fetch(destination.id, 0)
          %td= destination.published? ? "Yes" : "No"
          %td.import-cell
            - if (run = @latest_imports[destination.id])
              = import_status_badge(run)
              %small= import_status_detail(run)
            - else
              %small Never imported
          %td
            .actions
              = link_to "Edit", edit_admin_destination_path(destination), class: "button button--small"
              = button_to "Import from OSM", import_admin_destination_path(destination), class: "button button--small",
                disabled: @latest_imports[destination.id]&.active?

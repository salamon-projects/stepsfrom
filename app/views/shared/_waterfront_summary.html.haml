-# locals: (property:, large: false)
.waterfront-summary{ class: ("waterfront-summary--large" if large) }
  = waterfront_badge(property, large:)
  - if (parts = distance_parts(property))
    %p.waterfront-summary__distance
      %span.waterfront-summary__label= t("waterfront.measured_label")
      %span.waterfront-summary__metres= parts.first
      %span.waterfront-summary__to= parts.last
    = render "shared/distance_ruler", property:
  - notes = waterfront_notes(property)
  - if notes.any?
    %ul.waterfront-notes
      - notes.each do |level, text|
        %li{ class: "waterfront-notes__#{level}" }= text

- destination = @property.destination
- waterfront = @property.waterfront
- content_for :title, "#{@property.name}, #{destination.name} — #{t("waterfront.categories.#{waterfront.category}")}"
- content_for :description, [ measured_distance(@property), "#{property_kind(@property)} in #{destination.name}, #{destination.country_name}." ].compact.join(". ")
- content_for :canonical, property_url(@property)
- content_for(:noindex, true) if current_stay
= render "layouts/map_assets"

%section.page-header
  .container
    %nav.breadcrumbs{ "aria-label": "Breadcrumb" }
      = link_to "Destinations", root_path(anchor: "destinations")
      %span{ "aria-hidden": "true" } ›
      = link_to destination.name, destination_path(destination, stay_params)
    %h1.page-header__title= @property.name
    %p.page-header__lead
      = property_kind(@property)
      - if @property.address.present?
        = "· #{@property.address}"

.container.property-layout
  .property-layout__summary
    = render "shared/waterfront_summary", property: @property, large: true

  %aside.property-layout__booking
    .booking-panel
      %h2.booking-panel__title Compare booking sites
      = form_with url: property_path(@property), method: :get, class: "filter-form filter-form--compact" do
        = render "shared/stay_fields", stay: @stay
        .field.field--submit
          = submit_tag "Check prices", name: nil, class: "button button--primary"
      = render "shared/offers", offers: @offers
      %p.booking-panel__disclosure= t("offers.disclosure")

  .property-layout__details
    = map_tag(property_map_data(@property), css_class: "map map--property", label: "Map of #{@property.name} and the nearest shoreline")

    %section.checks
      %h2.checks__title What we checked
      %ul.checklist
        %li.checklist__item.checklist__item--ok
          Distance to the water measured from OpenStreetMap data
          - if waterfront.measured_at
            = "on #{l(waterfront.measured_at.to_date, format: :long)}"
        - if waterfront.crosses_road?
          %li.checklist__item.checklist__item--warn= t("waterfront.road_between")
        - else
          %li.checklist__item.checklist__item--ok No road or railway between the property and the water
        - if waterfront.crosses_promenade?
          %li.checklist__item.checklist__item--info= t("waterfront.promenade_between")
        - if (surface = beach_surface_label(@property))
          %li.checklist__item.checklist__item--info
            = surface
            - if waterfront.distance_to_beach_m.to_i.positive?
              = "#{waterfront.distance_to_beach_m} m away"
        %li.checklist__item.checklist__item--ok Position and result reviewed by our team
      %p.checks__more= link_to "How we verify", how_we_verify_path, class: "text-link"
